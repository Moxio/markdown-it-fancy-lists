{
	"compilerOptions": {
		"target": "es5",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"rootDir": "src",
		"declaration": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"outDir": "lib",
		"lib": [
			"es2018",
			"dom",
		]
	},
	"include": [
		"src/**/*.ts",
	]
}
