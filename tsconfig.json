{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"declaration": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"lib": [
			"es2018",
			"dom",
		]
	},
	"include": [
		"src/**/*.ts",
	]
}
